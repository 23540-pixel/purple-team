        // ==================== NAVIGATION & LOOKUP HELPERS ====================
        function switchTab(tabName) {
            currentTab = tabName;
            const tabs = ['sports', 'dashboard', 'roster', 'data'];
            tabs.forEach(t => {
                const sec = document.getElementById(`tab-${t}`);
                const btn = document.getElementById(`nav-${t}`);
                if (sec) sec.classList.toggle('hidden', t !== tabName);
                if (btn) {
                    if (t === tabName) {
                        btn.classList.remove('text-slate-400', 'font-medium');
                        btn.classList.add('text-purple-700', 'font-bold');
                    } else {
                        btn.classList.add('text-slate-400', 'font-medium');
                        btn.classList.remove('text-purple-700', 'font-bold');
                    }
                }
            });
            refreshAllViews();
        }

        function openMainPortal() {
            portalMode = 'main';
            activeSportId = null;
            activeCategoryId = null;
            activeDeptId = null;
            renderCurrentPortalView();
        }

        function getSportById(sportId) {
            return SPORTS_CONFIG.find(s => s.id === sportId) || null;
        }

        function getCategoryById(sportId, catId) {
            const sp = getSportById(sportId);
            if (!sp) return null;
            return sp.categories.find(c => c.id === catId) || null;
        }

        function getDeptById(deptId) {
            return DEPARTMENTS_CONFIG.find(d => d.id === deptId) || null;
        }

        function getAthleticsSlotInfo(catId, idx) {
            const id = String(catId || '');
            if (id.startsWith('ath_100_')) {
                if (idx === 0) return { label: '⭐ ตัวจริง', shortLabel: 'ตัวจริง', badgeClass: 'bg-emerald-100 text-emerald-800' };
                if (idx === 1) return { label: '🔄 สำรอง', shortLabel: 'สำรอง', badgeClass: 'bg-amber-100 text-amber-900' };
                return { label: '⚠️ เกินโควต้า', shortLabel: 'เกินโควต้า', badgeClass: 'bg-rose-100 text-rose-800' };
            }
            if (id.startsWith('ath_4x100_')) {
                if (idx >= 0 && idx <= 3) return { label: `⭐ ตัวจริง (ไม้ ${idx + 1})`, shortLabel: `ตัวจริง ไม้${idx + 1}`, badgeClass: 'bg-emerald-100 text-emerald-800' };
                if (idx === 4) return { label: '🔄 สำรอง', shortLabel: 'สำรอง', badgeClass: 'bg-amber-100 text-amber-900' };
                return { label: '⚠️ เกินโควต้า', shortLabel: 'เกินโควต้า', badgeClass: 'bg-rose-100 text-rose-800' };
            }
            return null;
        }

        function getAthletesInCategory(sportId, catId) {
            const list = [];
            Object.values(purpleTeam).forEach(m => {
                const enr = (m.enrollments || []).find(e => e.catId === catId && (!sportId || e.sportId === sportId));
                if (enr) {
                    list.push({
                        ...m,
                        slotOrder: typeof enr.slotOrder === 'number' ? enr.slotOrder : Number.MAX_SAFE_INTEGER,
                        enrollmentNote: enr.note || '',
                        displayNote: getMemberDisplayNote(m, catId)
                    });
                }
            });
            return list.sort((a, b) =>
                (a.slotOrder - b.slotOrder) ||
                String(a.cls || '').localeCompare(String(b.cls || ''), 'th', { numeric: true }) ||
                String(a.id || '').localeCompare(String(b.id || ''), undefined, { numeric: true })
            );
        }

        function moveAthleteSlot(studentId, catId, delta) {
            const list = getAthletesInCategory('athletics', catId);
            const idx = list.findIndex(m => String(m.id) === String(studentId));
            const targetIdx = idx + delta;
            if (idx === -1 || targetIdx < 0 || targetIdx >= list.length) return;

            list.forEach((item, i) => {
                const member = purpleTeam[String(item.id)];
                if (!member || !Array.isArray(member.enrollments)) return;
                const enr = member.enrollments.find(e => e.catId === catId);
                if (enr) enr.slotOrder = i + 1;
            });

            const memberA = purpleTeam[String(list[idx].id)];
            const memberB = purpleTeam[String(list[targetIdx].id)];
            const enrA = memberA?.enrollments?.find(e => e.catId === catId);
            const enrB = memberB?.enrollments?.find(e => e.catId === catId);

            if (enrA && enrB) {
                const tmp = enrA.slotOrder;
                enrA.slotOrder = enrB.slotOrder;
                enrB.slotOrder = tmp;
                persistRoomState();
                refreshAllViews();
                showToast('สลับลำดับตัวจริง/สำรองเรียบร้อยแล้ว', 'success');
            }
        }

        function getMembersInDept(deptId) {
            const dept = getDeptById(deptId);
            if (!dept) return [];
            const list = [];
            Object.values(purpleTeam).forEach(m => {
                const enr = (m.enrollments || []).find(e => e.catId === dept.catId || e.sportId === dept.id);
                if (enr) {
                    list.push({
                        ...m,
                        enrollmentNote: enr.note || '',
                        displayNote: getMemberDisplayNote(m, dept.catId)
                    });
                }
            });
            return list.sort((a, b) =>
                String(a.cls || '').localeCompare(String(b.cls || ''), 'th', { numeric: true }) ||
                String(a.id || '').localeCompare(String(b.id || ''), undefined, { numeric: true })
            );
        }

        function getMemberDisplayNote(member, catId = null) {
            if (!member) return '';
            const pNote = String(member.personalNote || '').trim();
            const enr = catId
                ? (member.enrollments || []).find(e => e.catId === catId)
                : null;
            const eNote = String(enr?.note || '').trim();

            if (pNote && eNote && pNote !== eNote && !pNote.includes(eNote) && !eNote.includes(pNote)) {
                return `${pNote} • ${eNote}`;
            }
            return pNote || eNote || '';
        }

        function getOfficerDisplayText() {
            if (!activeOfficer) return '';
            return activeOfficer.name
                ? `${activeOfficer.role} (${activeOfficer.name})`
                : activeOfficer.role;
        }

        function extractGrade(raw) {
            const s = String(raw || '').trim();
            const m = s.match(/ม\.?\s*([1-6])/);
            if (m) return `ม.${m[1]}`;
            const num = s.match(/^([1-6])\s*\//);
            if (num) return `ม.${num[1]}`;
            return '';
        }

        function normalizeClassLabel(gradeRaw, roomRaw) {
            const gStr = String(gradeRaw || '').trim();
            const rStr = String(roomRaw || '').trim().replace(/^\/+/, '');
            const fullMatch = gStr.match(/ม\.?\s*([1-6])\s*[\/\-]\s*(\d+)/) || gStr.match(/^([1-6])\s*[\/\-]\s*(\d+)$/);
            if (fullMatch) {
                return `ม.${fullMatch[1]}/${fullMatch[2]}`;
            }
            const g = extractGrade(gStr);
            if (g && rStr) return `${g}/${rStr}`;
            if (g) return g;
            return gStr || rStr || '-';
        }

        function isJuniorHigh(gradeOrClass) {
            const g = extractGrade(gradeOrClass);
            return g === 'ม.1' || g === 'ม.2' || g === 'ม.3';
        }

        function isSeniorHigh(gradeOrClass) {
            const g = extractGrade(gradeOrClass);
            return g === 'ม.4' || g === 'ม.5' || g === 'ม.6';
        }

        function isMaleStudent(name) {
            const n = String(name || '').trim();
            return /^(เด็กชาย|ด\.ช\.|นาย)/.test(n);
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            const bgClass = type === 'success'
                ? 'bg-emerald-700 text-white border-emerald-500'
                : type === 'error'
                    ? 'bg-rose-700 text-white border-rose-500'
                    : 'bg-purple-900 text-white border-purple-700';

            toast.className = `pointer-events-auto px-4 py-2.5 rounded-2xl shadow-xl border text-xs sm:text-sm font-bold animate-pop ${bgClass}`;
            toast.textContent = message;
            container.innerHTML = '';
            container.appendChild(toast);

            setTimeout(() => {
                if (toast.parentNode === container) {
                    toast.remove();
                }
            }, 2800);
        }

        function copyTextFallback(text, successMsg) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try {
                document.execCommand('copy');
                showToast(successMsg || 'คัดลอกเรียบร้อยแล้ว!', 'success');
            } catch (e) {
                showToast('ไม่สามารถคัดลอกอัตโนมัติได้ กรุณาคัดลอกด้วยตนเอง', 'error');
            }
            document.body.removeChild(ta);
        }

        function updateMultiDeviceStatusUI(roomCode = activeRoomCode) {
            const pill = document.getElementById('data-sync-status-pill');
            const roomLabel = document.getElementById('data-room-code-label');
            const badge = document.getElementById('cloud-sync-badge');

            if (roomLabel) roomLabel.textContent = roomCode;
            if (pill) pill.textContent = '💾 บันทึกในเครื่องอัตโนมัติ (GitHub Ready)';
            if (badge) badge.textContent = `💾 บันทึกในเครื่อง (${roomCode})`;
        }

        function openMultiDeviceModal() {
            const input = document.getElementById('room-code-input');
            if (input) input.value = activeRoomCode;
            updateMultiDeviceStatusUI(activeRoomCode);
            document.getElementById('multi-device-modal').classList.remove('hidden');
        }

        function closeMultiDeviceModal() {
            document.getElementById('multi-device-modal').classList.add('hidden');
        }

        function copyCurrentRoomCode() {
            copyTextFallback(activeRoomCode, `คัดลอกรหัสห้อง "${activeRoomCode}" เรียบร้อยแล้ว!`);
        }

        function applyRoomCodeChange() {
            const input = document.getElementById('room-code-input');
            const cleaned = String(input?.value || '')
                .trim()
                .toUpperCase()
                .replace(/[^A-Z0-9_-]/g, '');
            const nextRoom = cleaned || 'PURPLE-MAIN';
            if (input) input.value = nextRoom;

            persistRoomState(activeRoomCode);
            loadRoomState(nextRoom);
            updateMultiDeviceStatusUI(activeRoomCode);
            refreshAllViews();
            closeMultiDeviceModal();
            showToast(`สลับไปยังห้องข้อมูล "${activeRoomCode}" เรียบร้อยแล้ว!`,
