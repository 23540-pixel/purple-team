        const STORAGE_PREFIX = 'PURPLE_SPORTS_GH_V1';

        // ==================== STATE VARIABLES ====================
        let schoolDB = [];
        let purpleTeam = {};
        let attendanceLogs = [];
        let activeOfficer = null;
        let activeRoomCode = 'PURPLE-MAIN';

        let currentTab = 'sports';
        let portalMode = 'main'; // 'main' | 'sports_grid' | 'sport_detail' | 'dept_detail'
        let rosterViewMode = 'grid'; // 'grid' (ตารางติ๊กเรียงวัน) | 'card' (แบบการ์ดรายวัน)
        let activeSportId = null;
        let activeCategoryId = null;
        let activeDeptId = null;

