        // ==================== LOCAL PERSISTENCE (GITHUB PAGES READY) ====================
        function getRoomStorageKey(roomCode) {
            const cleanRoom = String(roomCode || 'PURPLE-MAIN').trim().toUpperCase() || 'PURPLE-MAIN';
            return `${STORAGE_PREFIX}_ROOM_${cleanRoom}`;
        }

        function persistRoomState(roomCode = activeRoomCode) {
            try {
                const cleanRoom = String(roomCode || 'PURPLE-MAIN').trim().toUpperCase() || 'PURPLE-MAIN';
                localStorage.setItem(`${STORAGE_PREFIX}_LAST_ROOM`, cleanRoom);
                if (activeOfficer) {
                    localStorage.setItem(`${STORAGE_PREFIX}_OFFICER`, JSON.stringify(activeOfficer));
                }
                const payload = {
                    schoolDB,
                    purpleTeam,
                    attendanceLogs,
                    updatedAt: new Date().toISOString()
                };
                localStorage.setItem(getRoomStorageKey(cleanRoom), JSON.stringify(payload));
            } catch (err) {
                console.warn('Local storage write warning:', err);
            }
        }

        function loadRoomState(roomCode = activeRoomCode) {
            const cleanRoom = String(roomCode || 'PURPLE-MAIN').trim().toUpperCase() || 'PURPLE-MAIN';
            activeRoomCode = cleanRoom;
            try {
                const savedOfficer = localStorage.getItem(`${STORAGE_PREFIX}_OFFICER`);
                if (savedOfficer) {
                    activeOfficer = JSON.parse(savedOfficer);
                }
                const raw = localStorage.getItem(getRoomStorageKey(cleanRoom));
                if (!raw) {
                    schoolDB = [];
                    purpleTeam = {};
                    attendanceLogs = [];
                    return;
                }
                const parsed = JSON.parse(raw);
                schoolDB = Array.isArray(parsed.schoolDB) ? parsed.schoolDB : [];
                purpleTeam = (parsed.purpleTeam && typeof parsed.purpleTeam === 'object') ? parsed.purpleTeam : {};
                attendanceLogs = Array.isArray(parsed.attendanceLogs) ? parsed.attendanceLogs : [];
            } catch (err) {
                console.warn('Local storage read warning:', err);
                schoolDB = [];
                purpleTeam = {};
                attendanceLogs = [];
            }
        }

        function initLocalStorageMode() {
            const lastRoom = localStorage.getItem(`${STORAGE_PREFIX}_LAST_ROOM`) || 'PURPLE-MAIN';
            loadRoomState(lastRoom);
            const badge = document.getElementById('cloud-sync-badge');
            if (badge) badge.textContent = `💾 บันทึกในเครื่อง (${activeRoomCode})`;
            updateMultiDeviceStatusUI(activeRoomCode);
        }

        // ==================== UTILITY & DATE HELPERS ====================
        function escapeHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function getTodayISO() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function getSelectedDate() {
            const el = document.getElementById('session-date');
            return (el && el.value) ? el.value : getTodayISO();
        }

        function getCurrentTimeStr() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            return `${hh}:${mm}`;
        }

        function formatThaiDate(isoStr) {
            if (!isoStr) return '-';
            const parts = String(isoStr).split('-');
            if (parts.length !== 3) return isoStr;
            const thaiMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
            const yearBE = (parseInt(parts[0], 10) + 543) % 100;
            const monthIdx = parseInt(parts[1], 10) - 1;
            const dayNum = parseInt(parts[2], 10);
            return `${dayNum} ${thaiMonths[monthIdx] || parts[1]} ${yearBE}`;
        }

        function getTrainingWeekdaysRange() {
            const selected = getSelectedDate();
            const year = parseInt(selected.split('-')[0], 10) || new Date().getFullYear();
            const todayIso = getTodayISO();
            const dayNames = ['อา.', 'จ.', 'อ.', 'พ.', 'พฤ.', 'ศ.', 'ส.'];
            const monthNames = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

            const start = new Date(year, 10, 23); // 23 พ.ย.
            const end = new Date(year, 11, 25);   // 25 ธ.ค.
            const list = [];

            for (let cur = new Date(start); cur <= end; cur.setDate(cur.getDate() + 1)) {
                const dow = cur.getDay();
                if (dow === 0 || dow === 6) continue; // เฉพาะวันจันทร์ - วันศุกร์
                const y = cur.getFullYear();
                const m = String(cur.getMonth() + 1).padStart(2, '0');
                const d = String(cur.getDate()).padStart(2, '0');
                const iso = `${y}-${m}-${d}`;
                list.push({
                    iso,
                    dayShort: dayNames[dow],
                    dateShort: `${cur.getDate()} ${monthNames[cur.getMonth()]}`,
                    isFriday: dow === 5,
                    isToday: iso === todayIso || iso === selected
                });
            }
            return list;
        }

        function setRosterViewMode(mode) {
            rosterViewMode = mode === 'card' ? 'card' : 'grid';
            renderCurrentPortalView();
        }

