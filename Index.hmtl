```html
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ระบบเช็กชื่อนักกีฬาสี • สีม่วง</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SheetJS สำหรับอ่านและส่งออกไฟล์ Excel (.xlsx / .xls / .csv) -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <!-- Google Fonts: Prompt & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Prompt', 'Inter', sans-serif;
            background-color: #F5F3FF;
            -webkit-tap-highlight-color: transparent;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        @keyframes popIn {
            0% { transform: scale(0.96); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-pop {
            animation: popIn 0.18s ease-out forwards;
        }
        .sticky-name-col {
            position: sticky;
            left: 0;
            z-index: 10;
            box-shadow: 3px 0 6px -2px rgba(88, 28, 135, 0.08);
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col pb-24">

    <!-- ==================== HEADER ==================== -->
    <header class="bg-gradient-to-br from-purple-950 via-purple-800 to-indigo-900 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-3xl mx-auto px-4 pt-3.5 pb-3">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-11 h-11 rounded-2xl bg-white/15 backdrop-blur-sm border border-white/25 flex items-center justify-center shadow-inner shrink-0 text-xl">
                        🏆
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <h1 class="text-base sm:text-xl font-bold tracking-tight truncate">เช็กชื่อสีม่วง • กีฬาสี</h1>
                            <span id="school-db-badge" class="text-[10px] sm:text-[11px] font-medium px-2 py-0.5 rounded-full bg-purple-950/70 border border-purple-400/30 text-purple-200">
                                ฐานข้อมูล: 0 คน
                            </span>
                            <button type="button" onclick="openMultiDeviceModal()" id="cloud-sync-badge" class="text-[10px] sm:text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-purple-950/70 hover:bg-purple-900 border border-purple-400/40 text-purple-200 transition cursor-pointer">
                                🌐 กำลังเชื่อมต่อ...
                            </button>
                        </div>
                        <p class="text-[11px] sm:text-xs text-purple-200 mt-0.5 truncate">กีฬา • เชียร์ • ผู้นำเชียร์ • สวัสดิการ • พาเหรด</p>
                    </div>
                </div>

                <!-- ปุ่มแสดงสถานะผู้เช็กชื่อ (ประธาน / รองประธาน) -->
                <button type="button" onclick="openGlobalOfficerModal()" id="officer-status-btn" class="px-3 py-2 rounded-xl bg-white/15 hover:bg-white/25 active:scale-95 transition text-xs font-semibold border border-white/25 flex items-center gap-1.5 shrink-0 max-w-[165px]">
                    <span id="officer-dot" class="w-2 h-2 rounded-full bg-amber-300 shrink-0"></span>
                    <span id="officer-label" class="truncate">ระบุผู้เช็กชื่อ</span>
                </button>
            </div>

            <!-- แถบเลือกวันที่เช็กชื่อ & ยอดรวมวันนี้ -->
            <div class="mt-3 bg-purple-950/45 backdrop-blur-sm rounded-2xl p-2 border border-white/15 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 flex-1">
                    <span class="text-xs text-purple-200 pl-1.5 shrink-0">📅 วันที่:</span>
                    <input type="date" id="session-date" onchange="onDateChange()" class="w-full max-w-[180px] bg-white text-slate-800 text-xs sm:text-sm font-semibold rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-purple-300">
                </div>
                <div class="flex items-center gap-1.5 bg-purple-600/80 px-3 py-1.5 rounded-xl border border-purple-400/30 shrink-0">
                    <span class="text-[11px] text-purple-100 hidden sm:inline">เช็กชื่อวันนี้:</span>
                    <span class="text-xs sm:text-sm font-bold text-white" id="header-today-count">มาแล้ว 0 คน</span>
                </div>
            </div>
        </div>
    </header>

    <!-- ==================== MAIN CONTENT ==================== -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-4 pt-4">

        <!-- แบนเนอร์แจ้งเตือนเมื่อยังไม่มีรายชื่อทั้งโรงเรียน -->
        <div id="empty-db-banner" class="mb-4 bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                    <span class="text-2xl shrink-0">📂</span>
                    <div>
                        <p class="text-xs sm:text-sm font-bold text-amber-950">เริ่มต้นใช้งาน • นำเข้าไฟล์รายชื่อ หรือลองกดดูตัวอย่าง</p>
                        <p class="text-[11px] sm:text-xs text-amber-800 mt-0.5">นำเข้าไฟล์รายชื่อนักเรียนทั้งโรงเรียน (.xlsx) หรือกดปุ่มโหลดข้อมูลตัวอย่างเพื่อดูหน้าตาตารางเช็กชื่อได้ทันที</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" onclick="loadDemoSampleData()" class="px-3 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow-sm transition">
                        ✨ โหลดข้อมูลตัวอย่าง
                    </button>
                    <button type="button" onclick="switchTab('data')" class="px-3 py-2 rounded-xl bg-purple-700 hover:bg-purple-800 text-white font-bold text-xs shadow-sm transition">
                        นำเข้าไฟล์ →
                    </button>
                </div>
            </div>
        </div>

        <!-- ==================== TAB 1: หน้าต่างหลัก & เช็กชื่อ (PORTAL) ==================== -->
        <section id="tab-sports" class="space-y-4">

            <!-- VIEW 1A: หน้าต่างหลัก (กีฬา / เชียร์ / ผู้นำเชียร์ / สวัสดิการ / พาเหรด) -->
            <div id="main-portal-view" class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-purple-950">🏠 หน้าต่างหลัก • เลือกฝ่ายหรือชนิดกีฬา</h2>
                        <p class="text-xs text-slate-500">เลือก "กีฬา" เพื่อแยกตามชนิดกีฬา หรือเลือกฝ่ายอื่นเพื่อเข้าเช็กชื่อรายชื่อน้องทันที</p>
                    </div>
                </div>

                <!-- การ์ดหน้าต่างหลัก 5 ส่วน -->
                <div id="main-portal-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
            </div>

            <!-- VIEW 1B: หน้าเลือกชนิดกีฬา -->
            <div id="sports-grid-view" class="hidden space-y-3 animate-pop">
                <div class="flex items-center justify-between gap-2">
                    <button type="button" onclick="openMainPortal()" class="px-3.5 py-2 rounded-xl bg-white hover:bg-purple-50 text-purple-900 border border-purple-200 font-bold text-xs flex items-center gap-1.5 shadow-sm transition">
                        ← กลับหน้าต่างหลัก
                    </button>
                    <span class="text-xs font-bold text-purple-800 bg-purple-100 px-3 py-1 rounded-full">🏆 หมวดกีฬา (7 ชนิดกีฬา)</span>
                </div>

                <div>
                    <h2 class="text-base sm:text-lg font-bold text-purple-950">🏅 เลือกชนิดกีฬาเพื่อเข้าเช็กชื่อ</h2>
                    <p class="text-xs text-slate-500">ประธานกีฬา หรือ รองประธานกีฬา กดเลือกกีฬาของตนเอง</p>
                </div>

                <!-- ตารางการ์ดชนิดกีฬาทั้งหมด -->
                <div id="sports-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
            </div>

            <!-- VIEW 1C: หน้าต่างภายในชนิดกีฬา (เลือกประเภท -> รายชื่อน้อง -> เช็กชื่อ) -->
            <div id="sport-detail-view" class="hidden space-y-4 animate-pop">
                <!-- แถบหัวข้อกีฬา & ปุ่มย้อนกลับ -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm">
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <button type="button" onclick="backToSportsGrid()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1 transition">
                            ← กลับหน้าเลือกกีฬา
                        </button>
                        <button type="button" id="detail-officer-badge" onclick="openSportAuthModal(activeSportId)" class="px-3 py-1.5 rounded-xl bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold text-xs flex items-center gap-1.5 transition">
                            👑 ยืนยันสิทธิ์ผู้เช็กชื่อ
                        </button>
                    </div>

                    <div class="flex items-center gap-3">
                        <div id="detail-sport-icon" class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-800 flex items-center justify-center text-2xl shrink-0">
                            ⚽
                        </div>
                        <div class="min-w-0 flex-1">
                            <h2 id="detail-sport-name" class="text-lg sm:text-xl font-bold text-purple-950">กีฬาฟุตบอล</h2>
                            <p id="detail-sport-officers" class="text-xs text-slate-500 mt-0.5">ผู้มีสิทธิ์เช็กชื่อ: ประธาน / รองประธานกีฬาฟุตบอล</p>
                        </div>
                    </div>

                    <!-- แถบเลือกประเภทการแข่งขัน (Category Tabs) -->
                    <div class="mt-4">
                        <p class="text-xs font-bold text-slate-600 mb-2">เลือกประเภทการแข่งขัน:</p>
                        <div id="category-tabs-container" class="flex flex-wrap gap-2"></div>
                    </div>
                </div>

                <!-- กล่องแสดงกติกาและโควต้าของประเภทที่เลือก -->
                <div id="category-rule-card" class="bg-white rounded-3xl p-4 sm:p-5 border-2 border-purple-200 shadow-sm space-y-3">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                        <div>
                            <span class="text-[11px] font-bold uppercase tracking-wider text-purple-700 bg-purple-100 px-2.5 py-0.5 rounded-full">ประเภทที่กำลังเปิดเช็กชื่อ</span>
                            <h3 id="active-cat-title" class="text-base sm:text-lg font-bold text-slate-900 mt-1">ม.ต้นชาย</h3>
                        </div>
                        <div class="text-right">
                            <p id="active-cat-quota-text" class="text-sm font-bold text-purple-800">ส่งรายชื่อ 0 / 15 คน</p>
                            <p id="active-cat-present-text" class="text-xs font-semibold text-emerald-700">มาเช็กชื่อวันนี้ 0 คน</p>
                        </div>
                    </div>

                    <!-- แถบความคืบหน้าจำนวนนักกีฬาในประเภท -->
                    <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                        <div id="active-cat-quota-bar" class="h-full bg-gradient-to-r from-purple-600 to-indigo-600 rounded-full transition-all" style="width: 0%"></div>
                    </div>

                    <!-- กล่องแสดงกติกาและผลตรวจสอบเงื่อนไขอัตโนมัติ -->
                    <div id="active-cat-rules-box" class="p-3 rounded-2xl bg-purple-50/80 border border-purple-100 text-xs text-purple-950 space-y-1.5"></div>

                    <!-- ปุ่มเพิ่มรายชื่อน้องเข้าประเภทนี้ -->
                    <div class="pt-1 flex flex-wrap gap-2">
                        <button type="button" onclick="openAddAthleteToCategoryModal()" id="btn-open-add-athlete" class="flex-1 py-3 px-4 bg-purple-700 hover:bg-purple-800 active:scale-98 text-white font-bold text-xs sm:text-sm rounded-2xl shadow transition flex items-center justify-center gap-2">
                            ➕ เพิ่มรายชื่อน้องเข้าประเภทนี้
                        </button>
                        <button type="button" onclick="checkInAllInCategory()" class="py-3 px-3.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-xs rounded-2xl transition">
                            ✅ เช็กชื่อยกทีม
                        </button>
                    </div>
                </div>

                <!-- รายชื่อน้องในประเภทที่เลือก -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h4 class="font-bold text-slate-800 text-sm sm:text-base">📋 รายชื่อนักกีฬาในประเภทนี้ (<span id="cat-roster-count">0</span> คน)</h4>
                        <div class="inline-flex rounded-xl bg-purple-50 p-1 border border-purple-200">
                            <button type="button" onclick="setRosterViewMode('grid')" id="cat-mode-grid-btn" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-700 text-white transition">
                                ☑️ ติ๊กเรียงวัน (23 พ.ย.–25 ธ.ค.)
                            </button>
                            <button type="button" onclick="setRosterViewMode('card')" id="cat-mode-card-btn" class="px-2.5 py-1 rounded-lg text-xs font-bold text-purple-800 transition">
                                📱 แบบการ์ดรายวัน
                            </button>
                        </div>
                    </div>

                    <div id="category-grid-container"></div>
                    <div id="category-athletes-list" class="space-y-2.5"></div>
                </div>
            </div>

            <!-- VIEW 1D: หน้าต่างฝ่ายที่ไม่ใช่กีฬา (เชียร์ / ผู้นำเชียร์ / สวัสดิการ / พาเหรด) -> เจอรายชื่อน้องเลย -->
            <div id="dept-detail-view" class="hidden space-y-4 animate-pop">
                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm space-y-3">
                    <div class="flex items-center justify-between gap-2">
                        <button type="button" onclick="openMainPortal()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs flex items-center gap-1 transition">
                            ← กลับหน้าต่างหลัก
                        </button>
                        <button type="button" id="dept-officer-badge" onclick="openDeptAuthModal(activeDeptId)" class="px-3 py-1.5 rounded-xl bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold text-xs flex items-center gap-1.5 transition">
                            👑 ยืนยันสิทธิ์ผู้เช็กชื่อ
                        </button>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3 min-w-0">
                            <div id="dept-detail-icon" class="w-12 h-12 rounded-2xl bg-purple-700 text-white flex items-center justify-center text-2xl shrink-0 shadow-sm">
                                📣
                            </div>
                            <div class="min-w-0">
                                <h2 id="dept-detail-name" class="text-lg sm:text-xl font-bold text-purple-950">เชียร์</h2>
                                <p id="dept-detail-officers" class="text-xs text-slate-500 mt-0.5 truncate">ผู้ดูแล: ประธาน / รองประธานฝ่ายเชียร์</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0">
                            <p id="dept-present-ratio" class="text-sm sm:text-base font-bold text-emerald-700">มา 0 / 0 คน</p>
                            <p id="dept-present-percent" class="text-[11px] font-semibold text-slate-400">0%</p>
                        </div>
                    </div>

                    <!-- แถบความคืบหน้าการมาเช็กชื่อวันนี้ -->
                    <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                        <div id="dept-progress-bar" class="h-full bg-gradient-to-r from-purple-600 to-emerald-500 rounded-full transition-all" style="width: 0%"></div>
                    </div>

                    <!-- ปุ่มเพิ่มรายชื่อน้อง & เช็กชื่อยกฝ่าย -->
                    <div class="pt-1 flex flex-wrap gap-2">
                        <button type="button" onclick="openAddAthleteToCategoryModal()" class="flex-1 py-3 px-4 bg-purple-700 hover:bg-purple-800 active:scale-98 text-white font-bold text-xs sm:text-sm rounded-2xl shadow transition flex items-center justify-center gap-2">
                            ➕ เพิ่มรายชื่อน้องเข้าฝ่ายนี้
                        </button>
                        <button type="button" onclick="checkInAllInDept()" class="py-3 px-3.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-xs rounded-2xl transition">
                            ✅ เช็กชื่อยกฝ่าย
                        </button>
                    </div>
                </div>

                <!-- รายชื่อน้องในฝ่ายนี้ (เปิดเข้ามาเจอทันที) -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h4 class="font-bold text-slate-800 text-sm sm:text-base">📋 รายชื่อน้องทั้งหมด (<span id="dept-roster-count">0</span> คน)</h4>
                        <div class="inline-flex rounded-xl bg-purple-50 p-1 border border-purple-200">
                            <button type="button" onclick="setRosterViewMode('grid')" id="dept-mode-grid-btn" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-700 text-white transition">
                                ☑️ ติ๊กเรียงวัน (23 พ.ย.–25 ธ.ค.)
                            </button>
                            <button type="button" onclick="setRosterViewMode('card')" id="dept-mode-card-btn" class="px-2.5 py-1 rounded-lg text-xs font-bold text-purple-800 transition">
                                📱 แบบการ์ดรายวัน
                            </button>
                        </div>
                    </div>

                    <!-- ช่องค้นหาด่วนภายในรายชื่อน้องของฝ่ายนี้ -->
                    <input type="text" id="dept-inline-search" oninput="renderDeptDetailView()" placeholder="🔍 ค้นหาชื่อ, รหัส หรือชั้น/ห้อง ในรายชื่อด้านล่าง..."
                        class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-200 focus:border-purple-500 focus:bg-white rounded-xl px-3.5 py-2.5 outline-none">

                    <div id="dept-grid-container"></div>
                    <div id="dept-athletes-list" class="space-y-2.5"></div>
                </div>
            </div>
        </section>

        <!-- ==================== TAB 2: สรุปยอดทุกกีฬา (DASHBOARD) ==================== -->
        <section id="tab-dashboard" class="hidden space-y-4">
            <!-- การ์ดตัวเลขสรุป 4 ช่อง -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="bg-white p-4 rounded-2xl border border-purple-100 shadow-sm">
                    <p class="text-xs text-slate-500 font-medium">สมาชิกสีม่วงทั้งหมด</p>
                    <p id="stat-total-athletes" class="text-2xl sm:text-3xl font-bold text-purple-800 mt-1">0</p>
                    <p class="text-[11px] text-purple-600 mt-1">คน (ไม่ซ้ำคน)</p>
                </div>
                <div class="bg-gradient-to-br from-purple-700 to-indigo-800 text-white p-4 rounded-2xl shadow-sm">
                    <p class="text-xs text-purple-200 font-medium">มาเช็กชื่อวันนี้</p>
                    <p id="stat-present-today" class="text-2xl sm:text-3xl font-bold mt-1">0</p>
                    <p id="stat-date-label" class="text-[11px] text-purple-200 mt-1">ประจำวัน</p>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-purple-100 shadow-sm">
                    <p class="text-xs text-slate-500 font-medium">ยังไม่มาเช็กชื่อ</p>
                    <p id="stat-absent-today" class="text-2xl sm:text-3xl font-bold text-rose-600 mt-1">0</p>
                    <p class="text-[11px] text-slate-400 mt-1">จากรายชื่อในระบบ</p>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-purple-100 shadow-sm">
                    <p class="text-xs text-slate-500 font-medium">การเข้าร่วมวันนี้</p>
                    <p id="stat-percent-today" class="text-2xl sm:text-3xl font-bold text-emerald-600 mt-1">0%</p>
                    <p class="text-[11px] text-slate-400 mt-1">คิดเป็นเปอร์เซ็นต์</p>
                </div>
            </div>

            <!-- สรุปยอด 4 ฝ่ายหลัก (เชียร์ / ผู้นำเชียร์ / สวัสดิการ / พาเหรด) -->
            <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-slate-800 text-sm sm:text-base">📣 สรุปยอดฝ่ายเชียร์ • ผู้นำเชียร์ • สวัสดิการ • พาเหรด</h3>
                    <span class="text-[11px] text-slate-400">กดเพื่อเปิดรายชื่อ</span>
                </div>
                <div id="dashboard-depts-breakdown" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
            </div>

            <!-- สรุปยอดแยกตามชนิดกีฬาและประเภทการแข่งขัน -->
            <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-slate-800 text-sm sm:text-base">🏆 สรุปยอดส่งรายชื่อ & เช็กชื่อแยกตามกีฬา</h3>
                    <span class="text-[11px] text-slate-400">กดที่ประเภทเพื่อเปิดดู</span>
                </div>
                <div id="dashboard-sports-breakdown" class="space-y-4"></div>
            </div>

            <!-- สรุปแยกตามระดับชั้น -->
            <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm">
                <h3 class="font-bold text-slate-800 text-sm sm:text-base mb-3">🏫 ยอดสมาชิกสีม่วงแยกตามระดับชั้น</h3>
                <div id="dashboard-grade-breakdown" class="space-y-2.5"></div>
            </div>
        </section>

        <!-- ==================== TAB 3: รายชื่อทั้งหมด & ฝ่ายต่างๆ (ROSTER) ==================== -->
        <section id="tab-roster" class="hidden space-y-4">
            <div class="bg-white rounded-3xl p-4 sm:p-5 border border-purple-100 shadow-sm space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 class="font-bold text-purple-950 text-base">💜 รายชื่อสมาชิกสีม่วงทั้งหมด (<span id="roster-count-badge">0</span> คน)</h3>
                    <button type="button" onclick="openAddManualModal()" class="px-3.5 py-2 bg-purple-700 hover:bg-purple-800 text-white text-xs font-semibold rounded-xl shadow-sm transition">
                        + เพิ่มรายชื่อ / ฝ่าย
                    </button>
                </div>

                <!-- ช่องค้นหาและตัวกรอง -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <input type="text" id="roster-search" oninput="renderRoster()" placeholder="ค้นหาชื่อ, รหัส หรือชั้น/ห้อง..."
                        class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 focus:outline-none focus:border-purple-500">
                    <select id="roster-sport-filter" onchange="renderRoster()" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5">
                        <option value="ALL">สังกัดกีฬา / ฝ่าย: ทั้งหมด</option>
                    </select>
                    <select id="roster-grade-filter" onchange="renderRoster()" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5">
                        <option value="ALL">ทุกระดับชั้น</option>
                        <option value="ม.1">มัธยมศึกษาปีที่ 1</option>
                        <option value="ม.2">มัธยมศึกษาปีที่ 2</option>
                        <option value="ม.3">มัธยมศึกษาปีที่ 3</option>
                        <option value="ม.4">มัธยมศึกษาปีที่ 4</option>
                        <option value="ม.5">มัธยมศึกษาปีที่ 5</option>
                        <option value="ม.6">มัธยมศึกษาปีที่ 6</option>
                    </select>
                    <select id="roster-status-filter" onchange="renderRoster()" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5">
                        <option value="ALL">สถานะวันนี้: ทั้งหมด</option>
                        <option value="PRESENT">✅ มาเช็กชื่อวันนี้แล้ว</option>
                        <option value="ABSENT">⏳ ยังไม่มาเช็กชื่อวันนี้</option>
                    </select>
                </div>
            </div>

            <div id="roster-list-container" class="space-y-2.5"></div>
        </section>

        <!-- ==================== TAB 4: จัดการข้อมูล & นำเข้า/ส่งออก (DATA) ==================== -->
        <section id="tab-data" class="hidden space-y-4">
            <!-- 0. สถานะการจัดเก็บข้อมูล & วิธีเอาขึ้น GitHub -->
            <div class="bg-gradient-to-br from-purple-900 via-purple-800 to-indigo-900 text-white rounded-3xl p-5 shadow-md border border-purple-500/30">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-emerald-400/20 text-emerald-200 border border-emerald-300/30" id="data-sync-status-pill">
                                💾 บันทึกในเครื่องอัตโนมัติ
                            </span>
                            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-white/15 text-purple-100">
                                ห้องข้อมูล: <span id="data-room-code-label">PURPLE-MAIN</span>
                            </span>
                        </div>
                        <h3 class="font-bold text-base sm:text-lg pt-1">🚀 พร้อมอัปโหลดขึ้น GitHub Pages (`index.html`)</h3>
                        <p class="text-xs text-purple-200">
                            ข้อมูลจะถูกบันทึกในเบราว์เซอร์ของเครื่องอัตโนมัติ และสามารถใช้ไฟล์สำรอง (.json) ส่งต่อหรือรวมยอดระหว่างประธานกีฬาได้
                        </p>
                    </div>
                    <button type="button" onclick="openMultiDeviceModal()" class="px-4 py-2.5 rounded-2xl bg-white text-purple-950 hover:bg-purple-50 font-bold text-xs shadow transition shrink-0">
                        🔗 ห้องข้อมูล / วิธีลง GitHub
                    </button>
                </div>
            </div>

            <!-- 1. นำเข้าไฟล์รายชื่อทั้งโรงเรียน -->
            <div class="bg-white rounded-3xl p-5 border border-purple-100 shadow-sm">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2.5">
                        <span class="w-8 h-8 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold">1</span>
                        <h3 class="font-bold text-slate-800 text-base">นำเข้าไฟล์รายชื่อนักเรียนทั้งโรงเรียน (.xlsx / .csv)</h3>
                    </div>
                    <button type="button" onclick="loadDemoSampleData()" class="px-3 py-1.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-xs transition shrink-0">
                        ✨ โหลดข้อมูลตัวอย่าง
                    </button>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 mb-4">
                    รองรับไฟล์รายชื่อนักเรียนแยกตามระดับชั้น (<code class="bg-purple-50 text-purple-800 px-1.5 py-0.5 rounded">m1-2-69.xlsx</code> ถึง <code class="bg-purple-50 text-purple-800 px-1.5 py-0.5 rounded">m6-2-69.xlsx</code>) ระบบจะดึงรหัส ชื่อ-นามสกุล และชั้น/ห้องให้อัตโนมัติ
                </p>

                <label class="block w-full border-2 border-dashed border-purple-300 hover:border-purple-600 bg-purple-50/50 hover:bg-purple-50 rounded-2xl p-6 text-center cursor-pointer transition">
                    <input type="file" id="excel-file-input" multiple accept=".xlsx,.xls,.csv" onchange="handleExcelUpload(event)" class="hidden">
                    <div class="w-12 h-12 rounded-2xl bg-purple-600 text-white flex items-center justify-center mx-auto mb-2 shadow text-xl">
                        📤
                    </div>
                    <p class="text-sm font-bold text-purple-900">แตะเพื่อเลือกไฟล์ Excel / CSV (เลือกพร้อมกันได้ทุกไฟล์)</p>
                    <p class="text-xs text-slate-500 mt-1">เมื่อบันทึกแล้ว ประธานแต่ละกีฬาและแต่ละฝ่ายสามารถค้นหาชื่อน้องเพื่อดึงเข้าทีมได้ทันที</p>
                </label>

                <div class="mt-3 flex items-center justify-between bg-slate-50 px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs">
                    <span class="text-slate-600">รายชื่อทั้งโรงเรียนในระบบตอนนี้:</span>
                    <span id="data-school-count" class="font-bold text-purple-800">0 คน</span>
                </div>
            </div>

            <!-- 2. ส่งออกรายงานสีม่วง (Export Excel / CSV) -->
            <div class="bg-white rounded-3xl p-5 border border-purple-100 shadow-sm">
                <div class="flex items-center gap-2.5 mb-2">
                    <span class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">2</span>
                    <h3 class="font-bold text-slate-800 text-base">ส่งออกรายชื่อนักกีฬาและฝ่าย "สีม่วง" ส่งอาจารย์</h3>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 mb-4">
                    ดาวน์โหลดตารางรายชื่อแยกตามชนิดกีฬา ประเภทการแข่งขัน และฝ่ายต่างๆ พร้อมตารางติ๊กเรียงวัน 23 พ.ย. – 25 ธ.ค.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button type="button" onclick="exportPurpleExcel()" class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white font-bold text-sm rounded-2xl shadow-sm flex items-center justify-center gap-2 transition">
                        📊 ดาวน์โหลดเป็น Excel (.xlsx)
                    </button>
                    <button type="button" onclick="exportPurpleCSV()" class="w-full py-3.5 px-4 bg-white hover:bg-slate-50 text-slate-800 border-2 border-slate-200 font-bold text-sm rounded-2xl flex items-center justify-center gap-2 transition">
                        📄 ดาวน์โหลดเป็น CSV (.csv)
                    </button>
                </div>
            </div>

            <!-- 3. สำรอง / ย้ายข้อมูลระหว่างเครื่องประธานกีฬา -->
            <div class="bg-white rounded-3xl p-5 border border-purple-100 shadow-sm space-y-3">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold">3</span>
                    <h3 class="font-bold text-slate-800 text-base">สำรองข้อมูล / รวมยอดหลายเครื่อง</h3>
                </div>
                <p class="text-xs text-slate-600">
                    ประธานแต่ละกีฬาหรือแต่ละฝ่ายสามารถกดส่งออกไฟล์สำรอง (<code class="bg-slate-100 px-1 rounded">.json</code>) แล้วส่งให้หัวหน้าสีรวมยอดเข้าด้วยกันได้ทันที
                </p>
                <div class="grid grid-cols-2 gap-2.5">
                    <button type="button" onclick="exportBackupJSON()" class="py-2.5 px-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-800 font-semibold text-xs sm:text-sm rounded-xl border border-indigo-200 transition">
                        💾 บันทึกไฟล์สำรอง
                    </button>
                    <label class="py-2.5 px-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-800 font-semibold text-xs sm:text-sm rounded-xl border border-indigo-200 text-center cursor-pointer transition">
                        📥 นำเข้า / รวมยอดไฟล์สำรอง
                        <input type="file" accept=".json" onchange="importBackupJSON(event)" class="hidden">
                    </label>
                </div>
            </div>

            <!-- 4. ล้างข้อมูล -->
            <div class="bg-white rounded-3xl p-5 border border-rose-100 shadow-sm">
                <h3 class="font-bold text-rose-700 text-sm mb-2">⚠️ จัดการรีเซ็ตระบบ (รหัสผ่าน 112)</h3>
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="confirmResetLogs()" class="px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-semibold">
                        ล้างเฉพาะประวัติเช็กชื่อ (เก็บรายชื่อไว้)
                    </button>
                    <button type="button" onclick="confirmResetAll()" class="px-3.5 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-semibold">
                        ล้างข้อมูลทั้งหมดในระบบ
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- ==================== BOTTOM NAVIGATION ==================== -->
    <nav id="bottom-nav" class="fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur-md border-t border-purple-100 shadow-[0_-4px_20px_rgba(88,28,135,0.06)] z-30">
        <div class="max-w-3xl mx-auto grid grid-cols-4 h-16">
            <button type="button" onclick="switchTab('sports')" id="nav-sports" class="nav-btn flex flex-col items-center justify-center gap-1 text-purple-700 font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-[11px]">หน้าหลักเช็กชื่อ</span>
            </button>
            <button type="button" onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn flex flex-col items-center justify-center gap-1 text-slate-400 font-medium">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span class="text-[11px]">สรุปยอด</span>
            </button>
            <button type="button" onclick="switchTab('roster')" id="nav-roster" class="nav-btn flex flex-col items-center justify-center gap-1 text-slate-400 font-medium">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="text-[11px]">รายชื่อทั้งหมด</span>
            </button>
            <button type="button" onclick="switchTab('data')" id="nav-data" class="nav-btn flex flex-col items-center justify-center gap-1 text-slate-400 font-medium">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
                </svg>
                <span class="text-[11px]">นำเข้า/ส่งออก</span>
            </button>
        </div>
    </nav>

    <!-- ==================== MODAL 1: ยืนยันสิทธิ์ประธาน / รองประธาน ==================== -->
    <div id="officer-auth-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl animate-pop">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-purple-100 text-purple-800">🔐 ยืนยันสิทธิ์ผู้เช็กชื่อ</span>
                <button type="button" onclick="closeOfficerModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">✕</button>
            </div>

            <h3 id="officer-modal-title" class="text-lg font-bold text-slate-900 mt-3">เลือกตำแหน่งผู้มีสิทธิ์เช็กชื่อ</h3>
            <p id="officer-modal-subtitle" class="text-xs text-slate-500 mt-0.5">เฉพาะประธาน หรือ รองประธาน ที่ได้รับมอบหมาย</p>

            <div class="mt-4 space-y-2 max-h-[42vh] overflow-y-auto pr-1" id="officer-role-options"></div>

            <div class="mt-3">
                <label class="block text-xs font-bold text-slate-700 mb-1">ชื่อเล่น / ชั้น-ห้อง ผู้เช็กชื่อ (ไม่บังคับ)</label>
                <input type="text" id="officer-custom-name" placeholder="เช่น ต้นเป้ง 5/3 หรือ โอ้ค 5/8" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:border-purple-600 outline-none">
            </div>

            <div class="mt-5 flex gap-2.5">
                <button type="button" onclick="closeOfficerModal()" class="w-1/3 py-3 rounded-2xl bg-slate-100 text-slate-700 font-bold text-sm">ปิด</button>
                <button type="button" onclick="confirmOfficerIdentity()" class="w-2/3 py-3 rounded-2xl bg-purple-700 hover:bg-purple-800 text-white font-bold text-sm shadow-lg shadow-purple-700/25">
                    ✅ ยืนยันเข้าเช็กชื่อ
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 2: เพิ่มรายชื่อน้องเข้าประเภทกีฬา / ฝ่าย ==================== -->
    <div id="add-athlete-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl animate-pop max-h-[92vh] flex flex-col">
            <div class="flex items-start justify-between shrink-0">
                <div>
                    <span id="add-modal-sport-badge" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-800">⚽ กีฬาฟุตบอล</span>
                    <h3 id="add-modal-cat-title" class="text-base sm:text-lg font-bold text-slate-900 mt-1">เพิ่มรายชื่อเข้า: ม.ต้นชาย</h3>
                </div>
                <button type="button" onclick="closeAddAthleteModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">✕</button>
            </div>

            <!-- ตัวเลือกประเภทย่อยสำหรับแบดมินตัน -->
            <div id="badminton-subevent-box" class="hidden mt-3 p-3 rounded-2xl bg-indigo-50 border border-indigo-200 shrink-0">
                <p class="text-xs font-bold text-indigo-950 mb-1.5">🏸 ระบุรายการแข่งขันแบดมินตันของน้อง (เลือกได้มากกว่า 1):</p>
                <div id="badminton-subevent-chips" class="flex flex-wrap gap-1.5"></div>
            </div>

            <!-- ช่องระบุหมายเหตุ / หน้าที่ของน้องก่อนกดเลือกเข้าทีม -->
            <div class="mt-3 shrink-0">
                <label for="athlete-quick-note" class="block text-xs font-bold text-purple-900 mb-1">📝 หมายเหตุ / หน้าที่ประจำตัว (ไม่บังคับ)</label>
                <input type="text" id="athlete-quick-note"
                    placeholder="เช่น แบกน้ำ, ดูแลน้ำดื่ม, ถือป้าย, ตัวสำรอง..."
                    class="w-full text-xs sm:text-sm bg-purple-50/50 border border-purple-200 focus:border-purple-600 focus:bg-white rounded-xl px-3.5 py-2 outline-none transition">
            </div>

            <!-- ช่องค้นหาน้องจากรายชื่อทั้งโรงเรียน -->
            <div class="mt-2.5 shrink-0">
                <div class="relative">
                    <input type="text" id="athlete-search-input" oninput="handleAthleteSearch()" autocomplete="off"
                        placeholder="🔍 พิมพ์รหัสนักเรียน หรือ ชื่อ-นามสกุล น้อง..."
                        class="w-full text-sm bg-slate-50 border-2 border-purple-200 focus:border-purple-600 focus:bg-white rounded-2xl px-4 py-3 pr-10 outline-none transition">
                    <button type="button" id="clear-athlete-search" onclick="clearAthleteSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-slate-200 text-slate-600 text-xs flex items-center justify-center">✕</button>
                </div>
                <div class="mt-1.5 flex items-center justify-end gap-2 text-[11px] text-slate-500">
                    <button type="button" onclick="openAddManualModal()" class="text-purple-700 font-bold hover:underline">+ กรอกชื่อเอง (กรณีไม่มีในไฟล์)</button>
                </div>
            </div>

            <!-- ผลการค้นหารายชื่อน้อง -->
            <div id="athlete-search-results" class="mt-3 overflow-y-auto space-y-2 flex-1 pr-1 min-h-[180px]">
                <p class="text-xs text-slate-400 text-center py-8">พิมพ์รหัสนักเรียนหรือชื่อน้องเพื่อเพิ่มเข้าทีม</p>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 3: เพิ่ม/แก้ไขข้อมูลสมาชิกด้วยตนเอง ==================== -->
    <div id="manual-student-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-4">
        <div class="bg-white w-full max-w-md rounded-3xl p-5 sm:p-6 shadow-2xl animate-pop max-h-[92vh] flex flex-col">
            <div class="flex items-center justify-between mb-3 shrink-0">
                <h3 id="manual-modal-title" class="text-base sm:text-lg font-bold text-purple-950">➕ เพิ่มรายชื่อสมาชิกสีม่วง</h3>
                <button type="button" onclick="closeManualModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">✕</button>
            </div>

            <div class="space-y-3 overflow-y-auto pr-1 flex-1">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">รหัสนักเรียน *</label>
                    <input type="text" id="manual-id" placeholder="เช่น 66101" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">ชื่อ-นามสกุล *</label>
                    <input type="text" id="manual-name" placeholder="เช่น เด็กชายธนกฤต ใจดี" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-sm">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">ระดับชั้น</label>
                        <select id="manual-grade" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm">
                            <option value="ม.1">ม.1</option>
                            <option value="ม.2">ม.2</option>
                            <option value="ม.3">ม.3</option>
                            <option value="ม.4">ม.4</option>
                            <option value="ม.5">ม.5</option>
                            <option value="ม.6">ม.6</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">ห้อง</label>
                        <input type="text" id="manual-room" placeholder="เช่น 1" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">ตำแหน่ง / ฝ่ายหลักในสีม่วง</label>
                    <select id="manual-role" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">📝 หมายเหตุ / หน้าที่ของตัวบุคคล</label>
                    <input type="text" id="manual-note" placeholder="เช่น แบกน้ำ, ดูแลน้ำดื่ม, ถือป้ายสีม่วง" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-sm">
                </div>
                <div class="flex items-center gap-2 pt-1" id="manual-auto-enroll-wrap">
                    <input type="checkbox" id="manual-auto-enroll" checked class="w-4 h-4 accent-purple-700 rounded">
                    <label for="manual-auto-enroll" id="manual-auto-enroll-label" class="text-xs font-medium text-slate-700">เพิ่มเข้าประเภทกีฬา/ฝ่ายที่เปิดอยู่ทันที</label>
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex gap-2 shrink-0">
                <button type="button" onclick="closeManualModal()" class="w-1/3 py-3 rounded-xl bg-slate-100 text-slate-700 font-bold text-sm">ยกเลิก</button>
                <button type="button" onclick="saveManualStudent()" class="w-2/3 py-3 rounded-xl bg-purple-700 hover:bg-purple-800 text-white font-bold text-sm">บันทึกข้อมูล</button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 4: พรีวิวการนำเข้าไฟล์ Excel ==================== -->
    <div id="import-preview-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-lg rounded-3xl p-5 sm:p-6 shadow-2xl animate-pop max-h-[90vh] flex flex-col">
            <h3 class="text-lg font-bold text-purple-950">📂 ตรวจสอบรายชื่อนักเรียนที่อ่านได้จากไฟล์</h3>
            <p id="import-summary-text" class="text-xs sm:text-sm text-slate-600 mt-1"></p>
            <div id="import-grade-breakdown" class="mt-2 flex flex-wrap gap-1.5"></div>

            <div class="mt-3 flex-1 overflow-y-auto border border-slate-200 rounded-2xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-purple-50 text-purple-900 sticky top-0">
                        <tr>
                            <th class="p-2.5">รหัส</th>
                            <th class="p-2.5">ชื่อ-นามสกุล</th>
                            <th class="p-2.5">ชั้น/ห้อง</th>
                        </tr>
                    </thead>
                    <tbody id="import-preview-tbody" class="divide-y divide-slate-100"></tbody>
                </table>
            </div>

            <div class="mt-4 space-y-2">
                <button type="button" onclick="confirmImportStudents(true)" class="w-full py-3 rounded-xl bg-purple-700 hover:bg-purple-800 text-white font-bold text-sm shadow">
                    ✅ แทนที่ฐานข้อมูลโรงเรียนเดิมทั้งหมด (แนะนำ)
                </button>
                <div class="flex gap-2">
                    <button type="button" onclick="closeImportPreview()" class="w-1/3 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-xs sm:text-sm">ยกเลิก</button>
                    <button type="button" onclick="confirmImportStudents(false)" class="w-2/3 py-2.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 font-bold text-xs sm:text-sm">
                        ➕ เพิ่มรวมกับข้อมูลเดิม
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 5: ยืนยันการลบ/รีเซ็ต ==================== -->
    <div id="confirm-dialog" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-3xl p-5 shadow-2xl animate-pop text-center">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-3 text-xl">⚠️</div>
            <h3 id="confirm-dialog-title" class="text-base font-bold text-slate-900">ยืนยันการทำรายการ</h3>
            <p id="confirm-dialog-msg" class="text-xs sm:text-sm text-slate-600 mt-1.5"></p>
            <div id="confirm-password-box" class="hidden mt-4 text-left">
                <label for="confirm-password-input" class="block text-xs font-bold text-rose-800 mb-1">🔐 กรอกรหัสผ่านเพื่อยืนยันการล้างข้อมูล</label>
                <input type="password" inputmode="numeric" id="confirm-password-input"
                    onkeydown="if(event.key==='Enter'){ event.preventDefault(); document.getElementById('confirm-dialog-yes').click(); }"
                    placeholder="กรอกรหัสผ่าน..."
                    class="w-full text-center tracking-widest font-bold text-base bg-rose-50/60 border-2 border-rose-200 focus:border-rose-500 focus:bg-white rounded-xl px-3.5 py-2.5 outline-none transition">
                <p id="confirm-password-error" class="hidden text-xs font-bold text-rose-600 mt-1.5 text-center">❌ รหัสผ่านไม่ถูกต้อง กรุณาลองใหม่</p>
            </div>
            <div class="mt-5 flex gap-2.5">
                <button type="button" onclick="closeConfirmDialog()" class="w-1/2 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-sm">ยกเลิก</button>
                <button type="button" id="confirm-dialog-yes" class="w-1/2 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm">ยืนยัน</button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 6: แก้ไขหมายเหตุรายบุคคล ==================== -->
    <div id="note-edit-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl animate-pop">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-900">📝 หมายเหตุรายบุคคล</span>
                <button type="button" onclick="closeNoteEditModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">✕</button>
            </div>

            <h3 id="note-edit-student-name" class="text-base sm:text-lg font-bold text-slate-900 mt-3">ชื่อนักเรียน</h3>
            <p id="note-edit-student-meta" class="text-xs text-slate-500 mt-0.5">ชั้น/ห้อง</p>

            <div class="mt-4">
                <label for="note-edit-input" class="block text-xs font-bold text-slate-700 mb-1.5">ระบุหน้าที่หรือหมายเหตุของคนนี้:</label>
                <input type="text" id="note-edit-input"
                    onkeydown="if(event.key==='Enter'){ event.preventDefault(); saveNoteEditModal(); }"
                    placeholder="เช่น แบกน้ำ, ดูแลน้ำดื่ม, ถือป้าย, คุมสแตน..."
                    class="w-full bg-slate-50 border-2 border-purple-200 focus:border-purple-600 focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition">
            </div>

            <!-- ปุ่มลัดหน้าที่ที่ใช้บ่อย -->
            <div class="mt-3">
                <p class="text-[11px] font-semibold text-slate-500 mb-1.5">แตะเพื่อเลือกข้อความด่วน:</p>
                <div class="flex flex-wrap gap-1.5">
                    <button type="button" onclick="setQuickNotePreset('แบกน้ำ')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">💧 แบกน้ำ</button>
                    <button type="button" onclick="setQuickNotePreset('ดูแลน้ำดื่ม')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">🥤 ดูแลน้ำดื่ม</button>
                    <button type="button" onclick="setQuickNotePreset('เตรียมอาหาร/ขนม')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">🍱 เตรียมอาหาร/ขนม</button>
                    <button type="button" onclick="setQuickNotePreset('ดูแลพยาบาล')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">🩹 ดูแลพยาบาล</button>
                    <button type="button" onclick="setQuickNotePreset('ถือป้ายสีม่วง')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">🪧 ถือป้ายสีม่วง</button>
                    <button type="button" onclick="setQuickNotePreset('คุมสแตนเชียร์')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">📣 คุมสแตนเชียร์</button>
                    <button type="button" onclick="setQuickNotePreset('ตัวสำรอง')" class="px-2.5 py-1 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200 text-xs font-semibold transition">🔄 ตัวสำรอง</button>
                </div>
            </div>

            <div class="mt-5 flex gap-2">
                <button type="button" onclick="clearNoteEditInput()" class="px-3 py-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-xs">ล้างข้อความ</button>
                <button type="button" onclick="saveNoteEditModal()" class="flex-1 py-3 rounded-2xl bg-purple-700 hover:bg-purple-800 text-white font-bold text-sm shadow-lg shadow-purple-700/25">
                    ✅ บันทึกหมายเหตุ
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL 7: ห้องข้อมูล & วิธีนำขึ้น GitHub Pages ==================== -->
    <div id="multi-device-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-5 sm:p-6 shadow-2xl animate-pop max-h-[92vh] overflow-y-auto">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-purple-100 text-purple-900">🚀 GitHub Pages & ห้องข้อมูล</span>
                <button type="button" onclick="closeMultiDeviceModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">✕</button>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mt-3">การจัดเก็บข้อมูล & การนำขึ้น GitHub</h3>
            <p id="multi-device-conn-desc" class="text-xs text-slate-600 mt-1">
                ไฟล์นี้ตั้งชื่อเป็น <code class="bg-slate-100 px-1.5 py-0.5 rounded font-bold">index.html</code> พร้อมอัปโหลดขึ้น GitHub Pages ได้ทันที โดยจะบันทึกข้อมูลในเครื่องอัตโนมัติ
            </p>

            <!-- กล่องรหัสห้องข้อมูลทีมสีม่วง -->
            <div class="mt-4 p-3.5 rounded-2xl bg-purple-50 border border-purple-200 space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-purple-950">🔑 รหัสห้องข้อมูลทีมสีม่วง (Room Code)</span>
                    <button type="button" onclick="copyCurrentRoomCode()" class="px-2.5 py-1 rounded-lg bg-purple-700 hover:bg-purple-800 text-white text-[11px] font-bold transition">
                        📋 คัดลอกรหัสห้อง
                    </button>
                </div>
                <div class="flex gap-2">
                    <input type="text" id="room-code-input" value="PURPLE-MAIN" placeholder="เช่น PURPLE-MAIN"
                        class="flex-1 bg-white border border-purple-300 rounded-xl px-3 py-2 text-sm font-bold uppercase text-purple-950 tracking-wider outline-none focus:border-purple-600">
                    <button type="button" onclick="applyRoomCodeChange()" class="px-3.5 py-2 rounded-xl bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-bold shrink-0 transition">
                        สลับห้องนี้
                    </button>
                </div>
            </div>

            <!-- ขั้นตอนสั้นๆ สำหรับเอาขึ้น GitHub Pages -->
            <div class="mt-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 space-y-1.5 text-xs text-slate-700">
                <p class="font-bold text-purple-950">📌 วิธีเปิดเว็บบน GitHub Pages:</p>
                <p>1. สร้าง Repository แบบ <strong>Public</strong> บน GitHub</p>
                <p>2. อัปโหลดไฟล์ <strong>index.html</strong> แล้วกด Commit changes</p>
                <p>3. ไปที่ <strong>Settings &gt; Pages</strong> → เลือก Branch <strong>main</strong> แล้วกด <strong>Save</strong></p>
                <p class="text-[11px] text-slate-500 pt-1">
                    * บน GitHub Pages ข้อมูลจะเก็บแยกตามเบราว์เซอร์ของแต่ละเครื่อง สามารถใช้ปุ่ม "บันทึกไฟล์สำรอง / นำเข้าไฟล์สำรอง" ในแท็บนำเข้า/ส่งออกเพื่อรวมยอดระหว่างเครื่องได้ครับ
                </p>
            </div>

            <div class="mt-5">
                <button type="button" onclick="closeMultiDeviceModal()" class="w-full py-3 rounded-2xl bg-purple-700 hover:bg-purple-800 text-white font-bold text-sm shadow">
                    เรียบร้อย
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== TOAST NOTIFICATION ==================== -->
    <div id="toast-container" class="fixed top-20 inset-x-0 flex justify-center z-50 pointer-events-none px-4"></div>

    <!-- ==================== MAIN APPLICATION SCRIPT ==================== -->
    <script>
        /**
         * ระบบเช็กชื่อนักกีฬาสีและฝ่ายต่างๆ - สีม่วง (เวอร์ชันพร้อมลง GitHub Pages)
         * โครงสร้างหลัก:
         * 1. หน้าต่างหลัก: กีฬา / เชียร์ / ผู้นำเชียร์ / สวัสดิการ / พาเหรด
         * 2. หน้าต่างกีฬา: เลือกชนิดกีฬา -> ประเภทการแข่งขัน -> ตรวจสอบโควต้า/กติกา -> เช็กชื่อ
         * 3. หน้าต่างฝ่ายอื่น: กดเข้าไปเจอรายชื่อน้องทันที -> เช็กชื่อรายคนหรือยกฝ่าย
         * 4. บันทึกข้อมูลอัตโนมัติในเครื่อง (localStorage) แยกตามรหัสห้อง พร้อมรองรับนำเข้า/ส่งออกไฟล์สำรอง (.json) และ Excel/CSV
         */
        const SPORTS_CONFIG = [
            {
                id: 'football',
                name: 'กีฬาฟุตบอล',
                icon: '⚽',
                colorClass: 'from-emerald-600 to-teal-700',
                badgeBg: 'bg-emerald-100 text-emerald-800',
                officers: ['ประธานกีฬาฟุตบอล', 'รองประธานกีฬาฟุตบอล'],
                categories: [
                    {
                        id: 'fb_jr_m',
                        name: 'ม.ต้นชาย',
                        max: 15,
                        level: 'jr',
                        gender: 'M',
                        ruleSummary: 'ส่งรายชื่อได้ไม่เกิน 15 คน (ระดับชั้น ม.1 – ม.3)'
                    },
                    {
                        id: 'fb_sr_m',
                        name: 'ม.ปลายชาย',
                        max: 15,
                        level: 'sr',
                        gender: 'M',
                        ruleSummary: 'ส่งรายชื่อได้ไม่เกิน 15 คน (ระดับชั้น ม.4 – ม.6)'
                    },
                    {
                        id: 'fb_all_f',
                        name: 'รวมหญิง (ม.ต้น-ม.ปลาย)',
                        max: 15,
